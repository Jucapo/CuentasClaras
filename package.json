{
  "name": "cuentas-claras",
  "version": "0.10.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke --project mobile",
    "e2e:screenshots": "playwright test --config playwright.screenshots.config.ts",
    "e2e:local": "playwright test --config playwright.local.config.ts",
    "lint": "ng lint && npm run lint:styles",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve --env-file supabase/functions/local.env",
    "db:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-backup.ts",
    "db:restore-local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-restore-local.ts",
    "supabase:types": "supabase gen types typescript --schema public > src/app/core/supabase/database.types.ts && prettier --write src/app/core/supabase/database.types.ts",
    "brand:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-brand-icons.ts",
    "icons:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-icon-font.ts && prettier --write src/app/shared/ui/icons/icon-codepoints.generated.ts"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.6.11",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "subset-font": "2.9.0",
    "supabase": "^3.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  }
}
